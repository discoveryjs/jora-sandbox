{
    "name": "jora-sandbox",
    "version": "1.4.0",
    "description": "Sandbox for Jora (a JSON query language)",
    "author": "Roman Dvornov <rdvornov@gmail.com>",
    "license": "MIT",
    "repository": "discoveryjs/jora-sandbox",
    "keywords": [
        "jora",
        "sandbox"
    ],
    "main": "./index.js",
    "scripts": {
        "start": "discovery",
        "lint": "eslint *.js src",
        "test": "npm run lint",
        "build": "npm run build:docs",
        "build:dist": "discovery-build -o dist --single-file",
        "build:docs": "discovery-build -o docs --clean",
        "prepublishOnly": "npm run build:dist"
    },
    "discovery": "src/config.js",
    "devDependencies": {
        "@discoveryjs/cli": "^2.14.7",
        "@discoveryjs/discovery": "^1.0.0-beta.99",
        "@stylistic/eslint-plugin": "^5.9.0",
        "eslint": "^10.0.2",
        "globals": "^17.3.0",
        "jora": "1.0.0-beta.15"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "files": [
        "dist",
        "index.js"
    ]
}
